# ─── Google PageSpeed Insights ────────────────────────────────────────────────
# Required for real use. Without a key Google applies a small shared quota that
# is usually exhausted, and performance/mobile/accessibility show "Not tested".
# Create one (free): https://developers.google.com/speed/docs/insights/v5/get-started
#   1. Google Cloud Console → APIs & Services → enable "PageSpeed Insights API"
#   2. Credentials → Create credentials → API key
#   3. Restrict the key to the PageSpeed Insights API
# Server-side only. Never prefix this with NEXT_PUBLIC_.
PAGESPEED_API_KEY=

# ─── Youth Studio contact links (report CTA, footer, floating button, PDF) ────
# The official WhatsApp (+966 53 389 6219, with a pre-filled message) and email
# (youthstudio2026@outlook.com) are built in. Set these only to override them.
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_CONTACT_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_STUDIO_URL=

# ─── Optional: AI-written executive summary ───────────────────────────────────
# With a key, Claude turns the verified findings into a short bilingual summary.
# Without one, the deterministic recommendations are used on their own.
ANTHROPIC_API_KEY=
# Set to "off" to disable the AI summary even when a key is present.
AI_RECOMMENDATIONS=

# ─── Optional: business analysis ──────────────────────────────────────────────
# The scan also renders the homepage in headless Chromium (screenshots, design,
# mobile layout, in-browser search tests). Set to "off" to skip that pass; the
# HTTP-based business checks (platform, products, sitemap, search) still run.
AUDIT_RENDER=

# ─── Local development only (ignored when NODE_ENV=production) ────────────────
# Point the scanner at a PageSpeed-compatible endpoint, e.g. `npm run psi:local`.
# PAGESPEED_API_BASE=http://localhost:4802
# Allow scanning localhost / private addresses and custom ports.
# AUDIT_ALLOW_PRIVATE_HOSTS=1
# Path to Chrome for PDF rendering if it is not found automatically.
# CHROME_EXECUTABLE_PATH=
