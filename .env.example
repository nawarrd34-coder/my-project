# Copy to .env.local and fill in. Never commit real values.
# Both are safe-to-ship public client keys; all real authorization is enforced
# by Postgres row level security, never by key secrecy.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by Supabase Edge Functions, never bundled into the app.
# Set with: supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_SERVICE_ROLE_KEY=
EXPO_ACCESS_TOKEN=
